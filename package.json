{
  "name": "difftab",
  "version": "0.1.1",
  "description": "See what your AI coding agent changed — a read-only local diff and branch viewer in a browser tab",
  "license": "MIT",
  "author": "zhangwanli",
  "homepage": "https://github.com/zhangwanli09/difftab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangwanli09/difftab.git"
  },
  "bugs": {
    "url": "https://github.com/zhangwanli09/difftab/issues"
  },
  "keywords": [
    "git",
    "diff",
    "git-diff",
    "diff-viewer",
    "working-tree",
    "cli",
    "read-only",
    "ai-agent",
    "coding-agent",
    "code-review"
  ],
  "type": "module",
  "bin": {
    "difftab": "bin/difftab.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {},
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vite build",
    "build:server": "tsdown",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "biome check",
    "test": "vitest run",
    "test:smoke": "node --test \"test/smoke/*.test.js\"",
    "fixtures": "node test/fixtures/make.mjs",
    "bench:startup": "node scripts/bench-startup.mjs",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "pnpm run build",
    "check:pack": "node scripts/check-pack.mjs",
    "check:css": "node scripts/check-css-cascade.mjs",
    "check:bin": "node scripts/check-bin-untouched.mjs",
    "check:global": "node scripts/check-global-install.mjs",
    "check:inotify": "node scripts/check-inotify-degrade.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@preact/signals": "2.11.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.20.1",
    "diff2html": "3.4.56",
    "happy-dom": "20.11.2",
    "highlight.js": "11.11.1",
    "lefthook": "2.1.10",
    "preact": "10.29.8",
    "tailwindcss": "4.3.3",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
